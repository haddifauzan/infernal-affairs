## Formal definition of the battle search problem:
##
##   State   S = (player_hp, npc_hp, player_potions, npc_potions,
##                player_defending, npc_defending, turn, turn_count)
##
##   Actions A = { ATTACK, HEAVY_ATTACK, DEFEND, POTION }   (branching â‰¤ 4)
##
##   Terminal Test:
##       player_hp â‰¤ 0  â†’ NPC wins
##       npc_hp    â‰¤ 0  â†’ Player wins
##       turn_count â‰¥ MAX_TURNS â†’ Draw
##
##   Utility  U(S, NPC):
##       +WIN_SCORE if NPC wins, -WIN_SCORE if Player wins, 0 if draw
##
## This file is a pure data class â€” no Godot node dependencies.
## â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
class_name BattleState
extends RefCounted

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# CONSTANTS
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const MAX_HP:        int = 100
const MAX_POTIONS:   int = 3
const MAX_TURNS:     int = 40     ## Safety ceiling â€” prevents infinite trees
const WIN_SCORE:     int = 10000  ## Terminal utility magnitude

## Turn identifiers
enum Turn { PLAYER = 0, NPC = 1 }

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# STATE FIELDS
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
var player_hp:        int  = MAX_HP
var npc_hp:           int  = MAX_HP
var player_potions:   int  = MAX_POTIONS
var npc_potions:      int  = MAX_POTIONS
var player_defending: bool = false   ## One-turn buff; cleared at start of attacker's next turn
var npc_defending:    bool = false
var turn:             int  = Turn.PLAYER
var turn_count:       int  = 0

# --- Tahap 3 Dynamic Stats (Local Search Dynamic Balancer) ---
var player_max_hp:     int = MAX_HP
var npc_max_hp:        int = MAX_HP
var player_atk_dmg:    int = 20
var player_heavy_dmg:  int = 37
var player_potion_heal:int = 30
var player_defense:    int = 5

var npc_atk_dmg:       int = 20
var npc_heavy_dmg:     int = 37
var npc_potion_heal:   int = 30
var npc_defense:       int = 5
var minimax_depth:     int = 3

var enemy_type:        String = "demon"
var enemy_name:        String = "Demon Brute"

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# TERMINAL TEST
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
func is_terminal() -> bool:
	return player_hp <= 0 or npc_hp <= 0 or turn_count >= MAX_TURNS

## Returns "player", "npc", or "draw" â€” call only when is_terminal() == true
func get_winner() -> String:
	if player_hp <= 0 and npc_hp <= 0:
		return "draw"
	if player_hp <= 0:
		return "npc"
	if npc_hp <= 0:
		return "player"
	return "draw"  # turn_count exhausted

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# UTILITY  (from NPC/maximiser perspective)
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
func terminal_utility() -> int:
	var winner := get_winner()
	match winner:
		"npc":    return  WIN_SCORE
		"player": return -WIN_SCORE
		_:        return  0

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# CLONE  (immutable-style tree search)
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
func clone() -> BattleState:
	var s          := BattleState.new()
	s.player_hp        = player_hp
	s.npc_hp           = npc_hp
	s.player_potions   = player_potions
	s.npc_potions      = npc_potions
	s.player_defending = player_defending
	s.npc_defending    = npc_defending
	s.turn             = turn
	s.turn_count       = turn_count

	s.player_max_hp     = player_max_hp
	s.npc_max_hp        = npc_max_hp
	s.player_atk_dmg    = player_atk_dmg
	s.player_heavy_dmg  = player_heavy_dmg
	s.player_potion_heal= player_potion_heal
	s.player_defense    = player_defense

	s.npc_atk_dmg       = npc_atk_dmg
	s.npc_heavy_dmg     = npc_heavy_dmg
	s.npc_potion_heal   = npc_potion_heal
	s.npc_defense       = npc_defense
	s.minimax_depth     = minimax_depth

	s.enemy_type        = enemy_type
	s.enemy_name        = enemy_name
	return s

# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# DISPLAY HELPERS
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
func state_string() -> String:
	return "P=%d(%d pot) D=%d(%d pot) t=%d/%d" % [
		player_hp, player_potions, npc_hp, npc_potions, turn_count, MAX_TURNS
	]
